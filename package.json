{
  "name": "ts-http-resilience",
  "version": "0.1.0",
  "description": "Zero-dependency typed fetch wrapper with exponential backoff, jitter, Retry-After support, per-attempt timeouts, and Idempotency-Key headers.",
  "type": "module",
  "license": "MIT",
  "author": "André Théo Lauret <andrelauret@eclipse-technology.eu> (https://eclipse-technology.eu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eldertek/ts-http-resilience.git"
  },
  "homepage": "https://github.com/eldertek/ts-http-resilience#readme",
  "bugs": {
    "url": "https://github.com/eldertek/ts-http-resilience/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "typescript",
    "fetch",
    "retry",
    "exponential-backoff",
    "jitter",
    "http-client",
    "idempotency",
    "resilience"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
